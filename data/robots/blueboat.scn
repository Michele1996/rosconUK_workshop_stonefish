<?xml version="1.0" encoding="utf-8"?>
<scenario>
  <looks>
    <look name="black" gray="0.05" roughness="0.2" metalness="0.0" />
    <look name="gray" gray="1" roughness="0.2" metalness="0.0" />
    <look name="transparent" gray="1.0" roughness="0.0" metalness="0.0" />
    <look name="blue" rgb="0.0 0.3 0.8" roughness="0.0" />
    <look name="yellow" rgb="1.0 1.0 0.0" roughness="0.0" />
    <look name="manipulator" gray="0.55" roughness="0.75" />
  </looks>

  <robot name="blueboat" fixed="false" self_collisions="false">
    <base_link name="Vehicle" type="compound" physics="submerged">
      <!-- TWO IDENTICAL PHYSICAL BOX HULLS, WITH ORIGINAL VISUAL MESHES.
           Box dims 1.139003 x 0.1717835 x 0.358401 m.
           Physical origins below account for native OBJ Y coordinates; the
           shared +0.01899725-m compound offset is retained so the *visuals*
           are unchanged. Final physical box Y centres = +/-0.34738925 m.
           BOTH hulls use submerged physics (the source had R floating / L submerged).
           Both hulls remain buoyant=false; existing flotation cylinders retained. -->
      <external_part name="SideR" type="model" physics="submerged" buoyant="false">
        <physical>
          <mesh filename="opti_blueboat/blueboat_hull_box_phy.obj" scale="1.0" convex="true" />
          <origin rpy="0.0 0.0 0.0" xyz="0.0224625 0.328392 -0.0554625" />
        </physical>
        <visual>
          <mesh filename="opti_blueboat/right_side_or.obj" scale="1.0" />
          <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
        </visual>
        <material name="Polyamid" />
        <mass value="4" />
        <look name="blue" />
        <compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.01899725 0.0" />
      </external_part>

      <external_part name="SideL" type="model" physics="submerged" buoyant="false">
        <physical>
          <mesh filename="opti_blueboat/blueboat_hull_box_phy.obj" scale="1.0" convex="true" />
          <origin rpy="0.0 0.0 0.0" xyz="0.0224625 -0.3663865 -0.0554625" />
        </physical>
        <visual>
          <mesh filename="opti_blueboat/left_side_or.obj" scale="1.0" />
          <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
        </visual>
        <material name="Polyamid" />
        <mass value="4" />
        <look name="blue" />
        <compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.01899725 0.0" />
      </external_part>

      <!-- Existing transverse and side boxes remain unchanged. They are already
           symmetric laterally in the previously balanced version. -->
      <external_part name="MetalRear" type="box" physics="surface" buoyant="false">
        <dimensions xyz="0.55 0.025 0.025" />
        <origin rpy="0.0 0.0 0.0" xyz="0.0 -0.26 -0.215" />
        <material name="Polyamid" />
        <mass value="2" />
        <look name="black" />
        <compound_transform rpy="0.0 0.0 -1.5707963267948966" xyz="0.0 0.0 0.0" />
      </external_part>

      <external_part name="MetalFront" type="box" physics="surface" buoyant="false">
        <dimensions xyz="0.55 0.025 0.025" />
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.32 -0.215" />
        <material name="Polyamid" />
        <mass value="2" />
        <look name="black" />
        <compound_transform rpy="0.0 0.0 -1.5707963267948966" xyz="0.0 0.0 0.0" />
      </external_part>

      <external_part name="LeftSideBox" type="box" physics="surface" buoyant="false">
        <dimensions xyz="0.42 0.128 0.025" />
        <origin rpy="0.0 0.0 1.5707963267948966" xyz="0.3525 0.025 -0.225" />
        <material name="Polyamid" />
        <mass value="0.5" />
        <look name="black" />
        <compound_transform rpy="0.0 0.0 -1.5707963267948966" xyz="0.0 0.0 0.0" />
      </external_part>

      <external_part name="RightSideBox" type="box" physics="surface" buoyant="false">
        <dimensions xyz="0.42 0.128 0.025" />
        <origin rpy="0.0 0.0 1.5707963267948966" xyz="-0.3525 0.025 -0.225" />
        <material name="Polyamid" />
        <mass value="0.5" />
        <look name="black" />
        <compound_transform rpy="0.0 0.0 -1.5707963267948966" xyz="0.0 0.0 0.0" />
      </external_part>

      <internal_part name="BatteryCylinder" type="cylinder" physics="submerged" buoyant="true">
        <dimensions radius="0.08" height="0.7" />
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
        <material name="Neutral" />
        <mass value="0.5" />
        <look name="manipulator" />
        <compound_transform rpy="0.0 1.5707963267948966 0.0" xyz="0.0 -0.3 -0.1" />
      </internal_part>

      <internal_part name="BatteryCylinder_2" type="cylinder" physics="submerged" buoyant="true">
        <dimensions radius="0.08" height="0.7" />
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
        <material name="Neutral" />
        <mass value="0.5" />
        <look name="manipulator" />
        <compound_transform rpy="0.0 1.5707963267948966 0.0" xyz="0.0 0.3 -0.1" />
      </internal_part>
    </base_link>

    <!-- VERIFIED PROPULSION SIGNS; DO NOT MATCH INVERTED_SETPOINT VALUES. -->
    <actuator name="Thruster_R" type="thruster">
      <link name="Vehicle" />
      <origin rpy="1.57 3.141592653589793 0.0" xyz="-0.472 0.28 0.0245" />
      <specs max_setpoint="366.5" inverted_setpoint="false" normalized_setpoint="true" />
      <propeller diameter="0.112" right="false">
        <mesh filename="meshes/real_bluerov_cw.obj" scale="1" />
        <material name="Neutral" />
        <look name="yellow" />
      </propeller>
      <rotor_dynamics type="first_order">
        <time_constant value="0.2" />
      </rotor_dynamics>
      <thrust_model type="fluid_dynamics">
        <thrust_coeff forward="0.07" reverse="0.11" />
        <torque_coeff value="0.015" />
      </thrust_model>
    </actuator>

    <actuator name="Thruster_L" type="thruster">
      <link name="Vehicle" />
      <origin rpy="0.0 3.141592653589793 0.0" xyz="-0.472 -0.28 0.0245" />
      <specs max_setpoint="366.5" inverted_setpoint="true" normalized_setpoint="true" />
      <propeller diameter="0.112" right="true">
        <mesh filename="meshes/real_bluerov_ccw.obj" scale="1" />
        <material name="Neutral" />
        <look name="yellow" />
      </propeller>
      <rotor_dynamics type="first_order">
        <time_constant value="0.2" />
      </rotor_dynamics>
      <thrust_model type="fluid_dynamics">
        <thrust_coeff forward="0.07" reverse="0.11" />
        <torque_coeff value="0.015" />
      </thrust_model>
    </actuator>

    <sensor name="dvl" type="dvl" rate="5.0">
      <link name="Vehicle" />
      <origin rpy="3.1416 0.0 -0.785" xyz="-0.75 0.0 0.4" />
      <specs beam_angle="30.0" />
      <range velocity="9.0 9.0 9.0" altitude_min="0.5" altitude_max="81.0" />
      <noise velocity="0.0015" altitude="0.001" />
      <ros_publisher topic="/blueboat/navigator/dvl_sim" altitude_topic="/blueboat/navigator/altitude" />
    </sensor>
    <sensor name="race_truth" type="odometry" rate="20.0">
      <link name="Vehicle" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <noise position="0.0" velocity="0.0" angle="0.0" angular_velocity="0.0" />
      <ros_publisher topic="/blueboat/race/ground_truth_odom" />
    </sensor>
    <sensor name="navigation_odom" type="odometry" rate="20.0">
      <link name="Vehicle" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <noise position="0.0" velocity="0.0" angle="0.0" angular_velocity="0.0" />
      <ros_publisher topic="/blueboat/odom" />
    </sensor>
    <sensor name="bow_camera" type="camera" rate="10.0">
      <link name="Vehicle" />
      <origin xyz="0.5 0.0 -0.45" rpy="1.57 0.0 1.57" />
      <specs resolution_x="640" resolution_y="480" horizontal_fov="90.0" />
      <ros_publisher topic="/blueboat/camera/image_raw" />
    </sensor>
    <sensor name="imu_filter" type="imu" rate="20.0">
      <link name="Vehicle" />
      <origin rpy="0.0 0.0 0.0" xyz="0.35 -0.35 -0.2" />
      <noise angle="0.000001745" angular_velocity="0.00001745" />
      <ros_publisher topic="/blueboat/navigator/imu" />
    </sensor>
    <sensor name="gps" type="gps" rate="1.0">
      <link name="Vehicle" />
      <origin rpy="0.0 0.0 0.0" xyz="-0.35 0.15 -0.35" />
      <noise ned_position="0.5" />
      <ros_publisher topic="/blueboat/navigator/gps" />
    </sensor>

    <world_transform rpy="0.0 0.0 0.0" xyz="-3.0 0.0 0.1" />
    <ros_subscriber thrusters="/blueboat/controller/thruster_setpoints_sim" />
    <ros_publisher thrusters="/blueboat/controller/thruster_state" />
    <ros_base_link_transforms publish="true" />
  </robot>
</scenario>
