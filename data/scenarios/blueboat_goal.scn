<?xml version="1.0"?>
<scenario>
  <environment>
    <ned latitude="41.7777" longitude="3.0333"/>
    <ocean/>
    <atmosphere>
      <sun azimuth="20.0" elevation="50.0"/>
    </atmosphere>
  </environment>

  <materials>
    <material name="Neutral" density="1000.0" restitution="0.5"/>
    <material name="Rock" density="3000.0" restitution="0.8"/>
    <material name="Fiberglass" density="1500.0" restitution="0.3"/>
    <material name="Aluminium" density="2710.0" restitution="0.7"/>
    <material name="Polyamid" density="1500.0" restitution="0.1"/>
    <material name="GoalMaterial" density="1000.0" restitution="0.1"/>
    <friction_table>
      <friction material1="Neutral" material2="Neutral" static="0.5" dynamic="0.2"/>
      <friction material1="Polyamid" material2="Polyamid" static="0.1" dynamic="0.05"/>
      <friction material1="GoalMaterial" material2="Polyamid" static="0.2" dynamic="0.1"/>
    </friction_table>
  </materials>

  <looks>
    <look name="GoalRed" rgb="1.0 0.0 0.0" roughness="0.5"/>
  </looks>

  <include file="$(find roscon_stonefish_workshop)/data/robots/blueboat.scn"/>

  <!-- Navigation target -->
  <static name="Goal" type="box">
    <dimensions xyz="1.0 1.0 1.0"/>
    <material name="GoalMaterial"/>
    <look name="GoalRed"/>
    <world_transform xyz="8.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </static>
</scenario>
