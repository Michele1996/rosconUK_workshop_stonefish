<?xml version="1.0"?>
<scenario>
<environment>
    <ned latitude="41.7777" longitude="3.0333" />
    <ocean />
    <atmosphere><sun azimuth="20.0" elevation="50.0" /></atmosphere>
  </environment>
  
<materials>
    <material name="Neutral" density="1000.0" restitution="0.5" />
    <material name="Rock" density="3000.0" restitution="0.8" />
    <material name="Fiberglass" density="1500.0" restitution="0.3" />
    <material name="Aluminium" density="2710.0" restitution="0.7" />
    <material name="Polyamid" density="1500.0" restitution="0.1" />
    <material name="MarkerMaterial" density="1000.0" restitution="0.1" />
    <friction_table>
      <friction material1="Neutral" material2="Neutral" static="0.5" dynamic="0.2" />
      <friction material1="Polyamid" material2="Polyamid" static="0.1" dynamic="0.05" />
    </friction_table>
  </materials>
  
<looks>
    <look name="RaceYellow" rgb="1.0 0.87 0.02" roughness="0.30" />
    <look name="RaceGreen" rgb="0.02 0.9 0.12" roughness="0.35" />
    <look name="RaceRed" rgb="0.95 0.02 0.08" roughness="0.35" />
    <look name="White" rgb="0.96 0.96 0.96" roughness="0.5" />
    <look name="Sign_CP01" gray="1.0" roughness="0.7" texture="$(find roscon_stonefish_workshop)/data/textures/sign_cp01.png" />
    <look name="Sign_CP02" gray="1.0" roughness="0.7" texture="$(find roscon_stonefish_workshop)/data/textures/sign_cp02.png" />
    <look name="Sign_CP03" gray="1.0" roughness="0.7" texture="$(find roscon_stonefish_workshop)/data/textures/sign_cp03.png" />
    <look name="Sign_CP04" gray="1.0" roughness="0.7" texture="$(find roscon_stonefish_workshop)/data/textures/sign_cp04.png" />
    <look name="Sign_CP05" gray="1.0" roughness="0.7" texture="$(find roscon_stonefish_workshop)/data/textures/sign_cp05.png" />
    <look name="Sign_CP06" gray="1.0" roughness="0.7" texture="$(find roscon_stonefish_workshop)/data/textures/sign_cp06.png" />
  </looks>
  
  <include file="$(find roscon_stonefish_workshop)/data/robots/blueboat_diagnostic_hull_only.scn"/>
</scenario>
