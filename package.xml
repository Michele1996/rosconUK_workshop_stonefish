<?xml version="1.0"?>
<package format="3">
  <name>roscon_stonefish_workshop</name>
  <version>0.2.0</version>
  <description>ROSCon UK 2026 Stonefish hands-on workshop.</description>
  <maintainer email="michele.grimaldi@hw.ac.uk">Michele Grimaldi</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>tf_transformations</exec_depend>
  <exec_depend>stonefish_ros2</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
